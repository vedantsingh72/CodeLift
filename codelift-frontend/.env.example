# Copy to ".env.local" for local dev (never commit real .env).
PORT=3000
REACT_APP_API_URL=http://localhost:3004/deploy
REACT_APP_STATUS_URL=http://localhost:3004/status
REACT_APP_PREVIEW_URL=http://localhost:3001

# On Vercel: set the same REACT_APP_* keys in Project → Settings → Environment Variables
# (Production) using your *public* API and preview URLs — never use localhost there.
